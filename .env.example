# REQUIRED by SEC: identify your automated client with a real contact email.
SEC_USER_AGENT="NTU AI6127 QuantRAG your_email@ntu.edu.sg"

# Required only for FRED live macro queries:
FRED_API_KEY=""

# Required only for `python src/query.py ... --answer`.
# Choose a model available from your provider; no model is hardcoded.
LLM_MODEL=""
LLM_API_KEY=""
# OPENAI_API_KEY is accepted as a fallback for LLM_API_KEY.
LLM_BASE_URL="https://api.openai.com/v1"
LLM_TIMEOUT_SECONDS="60"
# Set false for compatible providers without JSON object mode support.
# Local JSON/schema/citation validation still applies.
LLM_JSON_MODE="true"
